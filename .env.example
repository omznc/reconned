# DATABASE
DATABASE_URL="postgresql://username:password@localhost:5432/reconned"

# AUTHENTICATION
BETTER_AUTH_SECRET="your-super-secret-key-here"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# STORAGE (S3/CLOUD STORAGE)
S3_ENDPOINT="https://your-s3-endpoint.com"
S3_REGION="your-region"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="your-bucket-name"
NEXT_PUBLIC_CDN_URL="https://cdn.yourdomain.com"

# SOCIAL AUTHENTICATION
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# FILE UPLOADS
NEXT_PUBLIC_ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"
NEXT_PUBLIC_MAX_FILE_SIZE="5242880"
NEXT_PUBLIC_IMGUR_CLIENT_ID="your-imgur-client-id"

# ANALYTICS & MONITORING
PLAUSIBLE_API_KEY="your-plausible-api-key"
PLAUSIBLE_HOST="https://plausible.yourdomain.com"
PLAUSIBLE_SITE_ID="yourdomain.com"
NEXT_PUBLIC_AXIOM_DATASET="your-axiom-dataset"
NEXT_PUBLIC_AXIOM_TOKEN="your-axiom-token"

# COMMUNICATION & NOTIFICATIONS
ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_API_KEY="your-onesignal-api-key"
NTFY_ENDPOINT="https://ntfy.yourdomain.com"

# SECURITY & BOT PROTECTION
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
ADMIN_WEBHOOK_TOKEN="your-secure-admin-token"

# REDIS (CACHING & SESSIONS)
REDIS_URL="redis://localhost:6379"

# DEVELOPMENT & DEPLOYMENT
NEXT_PUBLIC_SOURCE_COMMIT="abc123def456"
CI="false"
