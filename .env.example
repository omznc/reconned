# ==========================================
# Docker Compose Configuration
# ==========================================

# Domain Configuration
# The domain where your application will be accessible
DOMAIN=reconned.com

# Traefik Configuration
# Email for Let's Encrypt SSL certificate notifications
TRAEFIK_ACME_EMAIL=admin@reconned.com

# Set to true to use Let's Encrypt staging server (for testing)
TRAEFIK_ACME_STAGING=false

# Traefik Dashboard (optional, for monitoring)
# Set to true to enable the Traefik dashboard
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_DASHBOARD_DOMAIN=traefik.reconned.com

# Database Configuration (for Docker)
POSTGRES_USER=reconned
POSTGRES_PASSWORD=reconned_dev_password_change_in_production
POSTGRES_DB=reconned

# Environment
# Set to "production" for production deployments
ENVIRONMENT=development

# Network Configuration
# Docker network name
NETWORK_NAME=reconned-network

# ==========================================
# Service URLs (Auto-configured by domain)
# ==========================================
# These are automatically set based on DOMAIN:
# Web:     https://${DOMAIN}
# Backend: https://${DOMAIN}/api
#
# For local development without domain:
# Web:     http://localhost:3000
# Backend: http://localhost:4000

# ==========================================
# Notes
# ==========================================
# 1. For local development without a domain:
#    - Set DOMAIN=localhost or DOMAIN=localhost:3000
#    - Traefik will handle routing on localhost
#
# 2. For production with SSL:
#    - Set DOMAIN to your actual domain (e.g., reconned.com)
#    - Set TRAEFIK_ACME_EMAIL to your email
#    - Ensure DNS points to your server
#    - Traefik will automatically obtain SSL certificates
#
# 3. For development/testing SSL:
#    - Set TRAEFIK_ACME_STAGING=true to avoid rate limits
#
# 4. Don't forget to configure apps/web/.env and apps/backend/.env
#    with the appropriate URLs based on your DOMAIN setting
