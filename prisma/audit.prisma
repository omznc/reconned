// Audit logs for tracking club actions
model ClubAuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Who performed the action
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Which club was affected
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  // What was done
  actionType String // e.g., "CLUB_CREATE", "MEMBER_INVITE", "MEMBER_REMOVE"
  actionData Json // Details about the action

  // Optional metadata
  ipAddress String? // IP address of the user
  userAgent String? // User agent info

  @@index([clubId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
}

// Track deleted entities to show "deleted" pages instead of 404
model DeletedEntity {
  id        String     @id @default(ulid())
  entityId  String
  entityType EntityType
  deletedAt DateTime   @default(now())

  @@unique([entityId, entityType])
  @@index([entityId])
  @@index([entityType])
}
