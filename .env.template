# ==========================================
# Reconned Environment Variables Reference
# ==========================================
# This file documents all environment variables used across the application.
# Copy the relevant sections to apps/web/.env and apps/backend/.env

# ==========================================
# SHARED VARIABLES (Used by both apps)
# ==========================================

# Database Configuration
DATABASE_URL=postgresql://reconned:reconned_dev_password@localhost:5432/reconned

# Better Auth Configuration
# IMPORTANT: Must be 32+ characters for security
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long-change-this

# Redis/Dragonfly Configuration
REDIS_URL=redis://localhost:6379

# S3-Compatible Storage Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=reconned-uploads

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OneSignal Push Notifications
# ONESIGNAL_APP_ID must be in UUID format
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_API_KEY=your-onesignal-api-key

# Cloudflare Turnstile CAPTCHA
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# CI Environment Indicator (Optional)
CI=

# ==========================================
# BACKEND-ONLY VARIABLES
# ==========================================

# Better Auth URL (Backend API base URL)
BETTER_AUTH_URL=http://localhost:4000

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://reconned.com,https://beta.reconned.com

# CDN URL for serving uploaded assets
CDN_URL=http://localhost:4000/cdn

# ==========================================
# WEB-ONLY VARIABLES
# ==========================================

# Admin Webhook Configuration
# IMPORTANT: Must be 32+ characters for security
ADMIN_WEBHOOK_TOKEN=your-webhook-token-at-least-32-characters-change-this

# Public Environment Variables (exposed to browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000/cdn
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# File Upload Configuration (Optional)
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp
NEXT_PUBLIC_MAX_FILE_SIZE=5242880

# Version Tracking (Optional)
NEXT_PUBLIC_SOURCE_COMMIT=

# Imgur Integration
NEXT_PUBLIC_IMGUR_CLIENT_ID=your-imgur-client-id

# Cloudflare Turnstile (Public Key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Axiom Logging
NEXT_PUBLIC_AXIOM_DATASET=reconned
NEXT_PUBLIC_AXIOM_TOKEN=your-axiom-token

# Beta Features Toggle (Optional)
NEXT_PUBLIC_BETA=false

# ==========================================
# DOCKER COMPOSE DEFAULTS
# ==========================================
# When using docker-compose.yml, these values are set automatically:
# - DATABASE_URL: postgresql://reconned:reconned_dev_password@postgres:5432/reconned
# - REDIS_URL: redis://dragonfly:6379
# - Service hostnames (postgres, dragonfly) instead of localhost

# ==========================================
# SECURITY NOTES
# ==========================================
# 1. NEVER commit .env files to version control
# 2. Use strong, unique secrets for production (32+ characters)
# 3. Change default database credentials in production
# 4. Restrict CORS_ORIGINS to trusted domains only
# 5. Use SSL/TLS for all external connections
# 6. Store secrets in a secure secrets manager for production

# ==========================================
# VALIDATION RULES
# ==========================================
# DATABASE_URL: Must be a valid PostgreSQL connection string
# BETTER_AUTH_SECRET: Minimum 32 characters
# ADMIN_WEBHOOK_TOKEN: Minimum 32 characters
# S3_BUCKET_NAME: Must match S3 bucket naming rules (lowercase, hyphens)
# ONESIGNAL_APP_ID: Must be a valid UUID
# REDIS_URL: Must start with redis://
# CORS_ORIGINS: Must be comma-separated valid URLs
# All *_URL variables: Must be valid URLs

# ==========================================
# QUICK START
# ==========================================
# 1. Copy apps/web/.env.example to apps/web/.env
# 2. Copy apps/backend/.env.example to apps/backend/.env
# 3. Run: ./docker-setup.sh (auto-generates secrets)
# 4. Configure OAuth and external service credentials
# 5. Run: docker compose up -d

# For detailed setup instructions, see DOCKER.md
