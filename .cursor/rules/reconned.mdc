### Data Table Patterns

#### Generic Data Table Usage
- Highly reusable component with flexible column configurations.
- Supports sorting, filtering, search, and mobile responsiveness.
- Column configurations include custom components, badge variants, and value mapping.
- Uses dot notation for nested property access.

#### Sheet/Modal Component Pattern
```typescript
interface EntitySheetProps {
  selectedEntity?: Entity;
  onClose?: () => void;
}

export function EntitySheet({ selectedEntity, onClose }: EntitySheetProps) {
  const t = useExtracted();
  
  return (
    <Credenza open={Boolean(selectedEntity)} onOpenChange={() => onClose?.()}>
      <CredenzaContent>
        <CredenzaHeader>
          <CredenzaTitle>{selectedEntity?.name || t("Does not exist")}</CredenzaTitle>
        </CredenzaHeader>
        <CredenzaBody>
          {/* Entity details */}
        </CredenzaBody>
      </CredenzaContent>
    </Credenza>
  );
}
```

### Error Handling & User Feedback

#### Toast Notification Pattern
- Use `sonner` for all user notifications.
- Consistent error/success messaging with translations.
- Error handling in try/catch blocks with fallback messages.

### Form Implementation

#### CRUD Form Pattern
```typescript
const [entityId, setEntityId] = useQueryState("entityId", { shallow: false, clearOnDefault: true, history: "replace" });

const form = useForm<FormValues>({
  resolver: zodResolver(schema),
  defaultValues: { /* from props.entity */ },
});

const isEdit = entityId !== "new" && Boolean(entity);

const onSubmit = async (data: FormValues) => {
  try {
    if (isEdit && entity) {
      const { error } = await apiClient.PUT("/api/.../{ id }", { params: { path: { id: entity.id } }, body: data });
      if (error) { toast.error(t("Failed to update")); return; }
      toast.success(t("Updated successfully"));
    } else {
      const { error } = await apiClient.POST("/api/...", { body: data });
      if (error) { toast.error(t("Failed to create")); return; }
      toast.success(t("Created successfully"));
    }
    setEntityId(null);
    form.reset();
    router.refresh();
  } catch (error) {
    console.error("Error:", error);
    toast.error(t("An error occurred"));
  }
};

const handleClose = () => {
  setEntityId(null);
  form.reset();
};
```

