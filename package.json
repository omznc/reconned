{
	"name": "reconned",
	"version": "0.6.0",
	"private": true,
	"packageManager": "bun@1.3.4",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "bun run dev:backend & timeout 10 sh -c 'until curl -sf http://localhost:3002/api/openapi.json > /dev/null 2>&1; do sleep 0.5; done' && bun run dev:web",
		"dev:backend": "bun run --filter 'backend' dev",
		"dev:web": "bun run --filter 'web' dev",
		"build": "bun run --filter '*' build",
		"check": "bunx --bun @biomejs/biome check --write .",
		"format": "bunx --bun @biomejs/biome format --write .",
		"lint": "bunx biome lint --write .",
		"knip": "knip",
		"typecheck": "bun run --filter '*' typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.7",
		"@types/bun": "1.3.3",
		"@types/node": "24.10.1",
		"knip": "5.70.2",
		"typescript": "5.9.3"
	},
	"overrides": {
		"import-in-the-middle": "1.14.2",
		"react-is": "^19.0.0",
		"drizzle-orm": "^0.45.1"
	},
	"dependencies": {
		"drizzle-zod": "^0.8.3"
	}
}
