# Secret token for admin webhook authentication
# Must be at least 32 characters for security
ADMIN_WEBHOOK_TOKEN=your-secure-webhook-token-min-32-chars

# Cloudflare Turnstile secret key for CAPTCHA verification (optional)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# CI environment indicator (optional)
# CI=true

# Backend API base URL
# Example: http://localhost:4000 or https://yourdomain.com/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# CDN base URL for static assets
NEXT_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# Better Auth authentication URL
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudflare Turnstile site key for CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Axiom dataset name for logs
NEXT_PUBLIC_AXIOM_DATASET=your-axiom-dataset-name

# Axiom API token for logging
NEXT_PUBLIC_AXIOM_TOKEN=your-axiom-api-token

# Encryption key for server actions
# Required in production to persist server action encryption across deploys/restarts
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-32-char-base64-encryption-key

# Enable beta features (optional)
# Set to "true" to enable, defaults to "false"
# NEXT_PUBLIC_BETA=false
