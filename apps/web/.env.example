# Database
DATABASE_URL=postgresql://reconned:reconned_dev_password@localhost:5432/reconned

# Better Auth (32+ character secret)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long-change-this

# S3 Storage Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=reconned-uploads

# Google OAuth
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OneSignal Push Notifications (UUID format)
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_API_KEY=your-onesignal-api-key

# Admin Webhook (32+ character token)
ADMIN_WEBHOOK_TOKEN=your-webhook-token-at-least-32-characters-change-this

# Cloudflare Turnstile (optional for development)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Redis/Dragonfly
REDIS_URL=redis://localhost:6379

# CI indicator (optional)
CI=

# Public Environment Variables
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_CDN_URL=http://localhost:4000/cdn
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# File Upload Configuration (optional)
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp
NEXT_PUBLIC_MAX_FILE_SIZE=5242880

# Version Tracking (optional)
NEXT_PUBLIC_SOURCE_COMMIT=

# Imgur Integration
NEXT_PUBLIC_IMGUR_CLIENT_ID=your-imgur-client-id

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Axiom Logging
NEXT_PUBLIC_AXIOM_DATASET=reconned
NEXT_PUBLIC_AXIOM_TOKEN=your-axiom-token

# Beta Features (optional)
NEXT_PUBLIC_BETA=false
