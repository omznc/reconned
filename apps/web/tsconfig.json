{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["dom", "dom.iterable", "esnext"],

		"target": "ESNext",
		"moduleDetection": "force",
		// Modules
		"module": "esnext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		// Strict Type Checking
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		// Type Declaration Settings
		"declaration": false,
		"inlineSources": true,
		"sourceMap": true,
		"allowArbitraryExtensions": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": {
			"next-intl": ["./src/i18n/shim/client.ts"],
			"next-intl/server": ["./src/i18n/shim/server.ts"],
			"@/*": ["./src/*"],
			"@components/*": ["./src/components/*"],
			"@auth/client": ["./src/lib/auth-client"],
			"@auth/server": ["./src/lib/auth"],
			"@public/*": ["./public/*"],
			"@generated/*": ["./generated/client/*"],
			"backend/*": ["../backend/src/*"],
			"@api": ["./src/lib/api"]
		},
		"incremental": true,
		// Interop Constraints
		"esModuleInterop": true,
		"allowJs": true,
		"noEmit": true,
		// ETC
		"allowImportingTsExtensions": true
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", ".output", "dist", "**/*.test.ts"]
}
