generator client {
  provider      = "prisma-client"
  output        = "../generated/client"
  binaryTargets = ["native", "darwin-arm64"]
  engineType = "client"
  runtime       = "bun"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MANAGER
  CLUB_OWNER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
  REQUESTED
}

enum ReviewType {
  USER
  CLUB
  EVENT
}
