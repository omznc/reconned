{
	"name": "backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.4",
	"exports": {
		"./*": "./src/*"
	},
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "bun build src/index.ts --outdir ./dist --target bun --external '*'",
		"start": "bun run dist/index.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed": "bun run src/drizzle/seed.ts",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.2.0",
		"@better-auth/passkey": "^1.4.6",
		"@react-email/components": "^1.0.1",
		"@t3-oss/env-core": "^0.13.8",
		"better-auth": "^1.4.6",
		"better-auth-harmony": "^1.2.5",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"i18n-iso-countries": "^7.14.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"@scalar/api-reference": "^1.25.52",
		"world-countries": "^5.1.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"bun-types": "^1.3.4",
		"@types/bun": "1.3.3",
		"@types/node": "24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.30.0",
		"typescript": "5.9.3"
	}
}
