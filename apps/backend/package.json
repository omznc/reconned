{
	"dependencies": {
		"@better-auth/api-key": "1.6.16",
		"@better-auth/passkey": "1.6.16",
		"@modelcontextprotocol/sdk": "1.29.0",
		"@opentelemetry/api-logs": "^0.218.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
		"@opentelemetry/resources": "^2.7.1",
		"@opentelemetry/sdk-logs": "^0.218.0",
		"@react-email/components": "^1.0.12",
		"@reconned/router": "^0.5.1",
		"@scalar/api-reference": "^1.59.2",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "1.6.16",
		"better-auth-harmony": "^1.3.2",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"i18n-iso-countries": "^7.14.0",
		"posthog-node": "^5.36.12",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"world-countries": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/react": "19.2.17",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "0.31.10"
	},
	"exports": {
		"./*": "./src/*"
	},
	"name": "backend",
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"build": "bun build src/index.ts --outdir ./dist --target bun --external '*'",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "bun run src/drizzle/seed.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js",
		"task": "bun run src/tasks/run-task.ts",
		"task:list": "bun run src/tasks/run-task.ts --list",
		"typecheck": "bunx tsc --noEmit"
	},
	"type": "module",
	"version": "0.1.0"
}
