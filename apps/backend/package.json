{
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.4.3",
		"@better-auth/passkey": "1.5.2",
		"@opentelemetry/api-logs": "^0.213.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
		"@opentelemetry/resources": "^2.6.0",
		"@opentelemetry/sdk-logs": "^0.213.0",
		"@opentelemetry/sdk-node": "^0.213.0",
		"@react-email/components": "^1.0.8",
		"@reconned/router": "^0.2.0",
		"@scalar/api-reference": "^1.46.4",
		"@t3-oss/env-core": "^0.13.10",
		"@types/bcrypt": "^6.0.0",
		"bcrypt": "^6.0.0",
		"better-auth": "1.5.2",
		"better-auth-harmony": "^1.3.1",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"i18n-iso-countries": "^7.14.0",
		"posthog-node": "^5.26.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"world-countries": "^5.1.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "1.3.10",
		"@types/node": "25.3.3",
		"@types/react": "19.2.14",
		"@types/react-dom": "^19.2.3",
		"bun-types": "1.3.10",
		"drizzle-kit": "0.31.9",
		"typescript": "5.9.3"
	},
	"exports": {
		"./*": "./src/*"
	},
	"name": "backend",
	"packageManager": "bun@1.3.10",
	"private": true,
	"scripts": {
		"build": "bun build src/index.ts --outdir ./dist --target bun --external '*'",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "bun run src/drizzle/seed.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js",
		"task": "bun run src/tasks/run-task.ts",
		"task:list": "bun run src/tasks/run-task.ts --list",
		"typecheck": "bunx tsc --noEmit"
	},
	"type": "module",
	"version": "0.1.0"
}
