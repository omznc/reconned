{
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.4.0",
		"@better-auth/passkey": "1.5.0-beta.6",
		"@opentelemetry/api-logs": "^0.210.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.210.0",
		"@opentelemetry/resources": "^2.4.0",
		"@opentelemetry/sdk-logs": "^0.210.0",
		"@opentelemetry/sdk-node": "^0.210.0",
		"@react-email/components": "^1.0.4",
		"@scalar/api-reference": "^1.43.4",
		"@t3-oss/env-core": "^0.13.10",
		"@types/bcrypt": "^6.0.0",
		"bcrypt": "^6.0.0",
		"better-auth": "1.5.0-beta.6",
		"better-auth-harmony": "^1.2.5",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"i18n-iso-countries": "^7.14.0",
		"posthog-node": "^5.21.0",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"world-countries": "^5.1.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@types/bun": "1.3.6",
		"@types/node": "25.0.8",
		"@types/react": "19.2.8",
		"@types/react-dom": "^19.2.3",
		"bun-types": "1.3.6",
		"drizzle-kit": "0.31.8",
		"typescript": "5.9.3"
	},
	"exports": {
		"./*": "./src/*"
	},
	"name": "backend",
	"packageManager": "bun@1.3.4",
	"private": true,
	"scripts": {
		"build": "bun build src/index.ts --outdir ./dist --target bun --external '*'",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:seed": "bun run src/drizzle/seed.ts",
		"db:studio": "drizzle-kit studio",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.js",
		"task": "bun run src/tasks/run-task.ts",
		"task:list": "bun run src/tasks/run-task.ts --list",
		"typecheck": "bunx tsc --noEmit"
	},
	"type": "module",
	"version": "0.1.0"
}
