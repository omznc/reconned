# Environment for the integration test suite (bun test). Only dummy/local values — never real
# credentials. The test harness spawns the server with exactly these variables.
# Port 3102 so the test server never collides with a running dev backend on 3002.
NODE_ENV=development
PORT=3102

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reconned_test
REDIS_URL=redis://localhost:6379/1

FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=test-secret-test-secret-test-secret-12345
BETTER_AUTH_URL=http://localhost:3102
CORS_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-client-secret

# Optional in the env schema, but set here so tests behave the same with and without a dev .env
# (locally Bun auto-loads .env first and real values would otherwise leak through).
FACEBOOK_APP_ID=test-facebook-app-id
FACEBOOK_APP_SECRET=test-facebook-app-secret

ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_API_KEY=test-onesignal-api-key
EMAIL_DISABLED=true

# Cloudflare Turnstile always-pass test secret: accepts any token value.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

INTERNAL_API_SECRET=test-internal-secret-test-internal-secret

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-key
S3_BUCKET_NAME=test-bucket
CDN_URL=http://localhost:9000/test-bucket

POSTHOG_PUBLIC_KEY=phc_test
POSTHOG_LOGS_ENABLED=false
LOG_LEVEL=error
