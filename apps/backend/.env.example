
# PostgreSQL database connection string
# Must start with "postgres://" or "postgresql://"
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Secret key for Better Auth sessions
# Must be at least 32 characters for security
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long

# Better Auth base URL
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth credentials (optional)
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret

# Comma-separated list of allowed CORS origins
# Example: http://localhost:3000,https://yourdomain.com,https://beta.yourdomain.com
CORS_ORIGINS=http://localhost:3000,https://reconned.com,https://beta.reconned.com

# Redis connection URL for caching and sessions
REDIS_URL=redis://localhost:6379

# OneSignal application ID (must be a valid UUID)
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000

# OneSignal REST API key
ONESIGNAL_API_KEY=your-onesignal-api-key

# Cloudflare Turnstile secret key for CAPTCHA verification
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# S3-compatible storage endpoint URL
S3_ENDPOINT=https://s3.amazonaws.com

# S3 region (e.g., us-east-1, eu-west-1)
S3_REGION=us-east-1

# S3 access credentials
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# S3 bucket name (must be lowercase, numbers, and hyphens only)
S3_BUCKET_NAME=your-bucket-name

# CDN base URL for serving uploaded assets
CDN_URL=https://cdn.yourdomain.com

# CI environment indicator (optional)
# Set to "true" to skip validation in CI environments
# CI=true
