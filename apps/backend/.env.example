# Database
DATABASE_URL=postgresql://reconned:reconned_dev_password@localhost:5432/reconned

# Better Auth (32+ character secret)
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long-change-this
BETTER_AUTH_URL=http://localhost:4000

# CORS Configuration (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,https://reconned.com,https://beta.reconned.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis/Dragonfly
REDIS_URL=redis://localhost:6379

# OneSignal Push Notifications (UUID format)
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_API_KEY=your-onesignal-api-key

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# S3 Storage Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=reconned-uploads

# CDN URL
CDN_URL=http://localhost:4000/cdn

# Facebook OAuth (optional)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# CI indicator (optional)
CI=
